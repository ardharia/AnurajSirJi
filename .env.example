# Application
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_ROOT=.

# Paths (relative to PROJECT_ROOT unless absolute)
DATA_DIR=data
KNOWLEDGE_DIR=data/knowledge
CONFIG_PATH=config/defaults.yaml

# RAG pipeline
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_VECTOR_STORE_PATH=data/processed/vector_store
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# VLM pipeline
VLM_ENABLED=true
VLM_PROVIDER=openai
VLM_MODEL=gpt-4o
VLM_API_KEY=
VLM_BASE_URL=
VLM_MAX_TOKENS=2048
VLM_TEMPERATURE=0.0

# LLM for structured extraction (may share provider with VLM)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# Fragility analysis
FRAGILITY_METHOD=lognormal
FRAGILITY_N_SAMPLES=10000
FRAGILITY_RANDOM_SEED=42

# Validation
VALIDATION_STRICT=true
VALIDATION_MIN_CONFIDENCE=0.5
